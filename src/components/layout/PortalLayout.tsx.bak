import * as React from 'react'
import Link from 'next/link'
import Image from 'next/image'
import { cn } from '@/lib/utils'
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/Avatar'
import { LogOut } from 'lucide-react'

export interface NavItem {
  label: string
  href: string
  icon: React.ReactNode
}

interface PortalLayoutProps {
  role: 'student' | 'faculty' | 'hod' | 'admin'
  userName: string
  navItems: NavItem[]
  children: React.ReactNode
  currentPage: string
}

export function PortalLayout({ role, userName, navItems, children, currentPage }: PortalLayoutProps) {
  const isActive = (href: string) =>
    currentPage === href || (currentPage !== '/' && currentPage.startsWith(href + '/'))

  const homeHref = role === 'student' ? '/dashboard' : '/admin'
  const notifHref = '/dashboard/notifications'

  return (
    <div className="min-h-screen bg-gray-50">
      <aside
        className="fixed inset-y-0 left-0 z-40 w-72 lg:flex flex-col bg-navy text-white">
        <div className="flex items-center gap-3 p-5 border-b border-white/10">
          <Image src="/logo.svg" alt="V.S.B. Engineering College Logo" width={40} height={40} className="border-rounded-lg" />
          <div className="min-w-0">
            <p className="text-sm font-bold text-white leading-tight truncate">V.S.B. Engineering College</p>
            <p className="text-xs text-gray-400 truncate">AI & DS Digital Portal</p>
          </div>
        </div>
        <nav className="flex-1 overflow-y-auto p-2 space-y-1" aria-label="Main navigation">
          {navItems.map((item) => (
            <Link
              key={item.href}
              href={item.href}
              className={cn(
                'flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-all duration-200',
                isActive(item.href) ? 'bg-royal text-white shadow-md' : 'text-gray-300 hover:bg-white/10 hover:text-white'
              )}
            >
              <span className="shrink-0 text-base">{item.icon}</span>
              <span className="truncate">{item.label}</span>
            </Link>
          ))}
        </nav>
        <div className="p-4 border-t border-white/10">
          <Link href="/api/auth/logout" className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-red-400 hover:bg-white/10 hover:text-red-300 transition-all duration-200">
            <LogOut className="h-4 w-4" /> Logout
          </Link>
        </div>
      </aside>

      <header className="sticky top-0 z-30 bg-white border-b border-gray-200 shadow-sm lg:pl-40">
        <div className="flex h-16 items-center gap-4 px-4 sm:px-6">
          <Link href={homeHref} className="flex items-center gap-2">
            <Image src="/logo.svg" alt="V.S.B. Engineering College logo" width={32} height={32} className="rounded-full" />
            <span className="hidden sm:inline text-sm font-semibold text-navy">V.S.B. AI & DS Portal</span>
          </Link>
          <div className="ml-auto flex items-center gap-3">
            <Link
              href={notifHref}
              className="relative p-2 rounded-full hover:bg-gray-100"
              aria-label="Notifications"
            >
              <svg className="h-5 w-5 text-navy" aria-hidden="true">
                <path d="M6 8a6.45 6.45 0 0 0 0 2-4.26a1.72 1.72 0 0 1 1 1.26l-.5.5M18 8a6.45 6.45 0 0 0 0 2-4.26" />
              </svg>
              <span className="absolute top-1 right-1 h-2 w-2 rounded-full bg-gold" aria-hidden="true" />
            </svg>
            <Avatar className="h-9 w-9 border-2 border-royal">
              <AvatarFallback className="bg-royal text-white">{userName.charAt(0) || 'U'}</AvatarFallback>
            </Avatar>
            <div className="hidden md:block text-right leading-tight">
              <p className="text-sm font-semibold text-navy leading-tight truncate">{userName}</p>
              <p className="text-xs text-gray-500 capitalize">{role}</p>
            </div>
          </div>
        </div>
      </header>

      <main className="lg:pl-40 pb-24">
        <div className="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8">{children}</div>
      </main>

      <nav className="fixed bottom-0 inset-x-0 z-50 lg:hidden bg-white border-t border-gray-200 grid grid-cols-4 pb-4" aria-label="Bottom navigation">
        <a
          href="/dashboard"
          className="flex flex-col items-center gap-1 py-2 text-xs transition-colors">
          <svg viewBox="0 0 24 24" className="h-5 w-5 mb-1" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
            <path d="M3 10.5V21h19V21M3 21h18M3 10.5m0.75-4.5-5.5-4.5" />
          </svg>
          <span>Home</span>
        </a>
        <a
          href="/dashboard/study"
          className="flex flex-col items-center gap-1 py-2 text-xs transition-colors">
          <svg viewBox="0 0 24 24" className="h-4 w-4 mb-1" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
            <path d="M4 19.5v-2H20M4 19.5v-2A4 4 0 0 0 12 4.5" />
          </svg>
          <span>Study</span>
        </a>
        <a
          href="/dashboard/projects"
          className="flex flex-col items-center gap-1 py-2 text-xs transition-colors">
          <svg viewBox="0 0 24 24" className="h-4 w-4 mb-1" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
            <path d="M4 18h16M4 13h16M4 8h16" />
          </svg>
          <span>Projects</span>
        </a>
        <a
          href="/dashboard/notifications"
          className="flex flex-col items-center gap-1 py-2 text-xs transition-colors">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
            <path d="M6 8a6.45 6.45 0 0 0 0 2-4.26a1.72 1.72 0 0 1 1 1.26l-.5.5M18 8a6.45 6.45 0 0 0 0 2-4.26" />
          </svg>
          <span>Alerts</span>
        </a>
      </nav>
    </div>
  )
}
{
  "id": "/?source=pwa",
  "name": "Digital Portal of AI&DS",
  "short_name": "VSB AI&DS",
  "description": "V.S.B. Engineering College - Department of Artificial Intelligence & Data Science Digital Portal, Karur, Tamil Nadu",
  "start_url": "/login",
  "scope": "/",
  "display": "standalone",
  "display_override": ["tabbed", "standalone", "window-controls-overlay", "minimal-ui", "browser"],
  "tab_strip": {
    "home_tab": {
      "scope": "/"
    },
    "new_tab_button": {
      "url": "/dashboard"
    }
  },
  "orientation": "portrait-primary",
  "background_color": "#071A41",
  "theme_color": "#071A41",
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=in.edu.vsb.aidsportal",
      "id": "in.edu.vsb.aidsportal"
    },
    {
      "platform": "webapp",
      "url": "https://aids-digital-portal.vercel.app/manifest.json"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "categories": ["education", "productivity", "utilities"],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "auto"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "scope_extensions": [
    {
      "origin": "https://aids-digital-portal.vercel.app"
    },
    {
      "origin": "https://vercel.app"
    },
    {
      "origin": "https://vsb.edu.in"
    }
  ],
  "file_handlers": [
    {
      "action": "/dashboard/resources",
      "name": "Academic PDF Documents",
      "icons": [
        {
          "src": "/shortcut-icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/pdf": [".pdf"],
        "text/plain": [".txt"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+vsbportal",
      "url": "/login?action=%s"
    }
  ],
  "share_target": {
    "action": "/dashboard/resources",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "VSB Attendance & Bell Timings",
      "description": "Quick view of 8-period attendance and timetable schedule",
      "tag": "attendance-widget",
      "template": "attendance-template",
      "ms_ac_template": "widgets/attendance.json",
      "data": "/api/attendance",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.png",
          "sizes": "720x1280",
          "label": "Attendance Widget Preview"
        }
      ],
      "icons": [
        {
          "src": "/shortcut-icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "note_taking": {
    "new_note_url": "/dashboard/study"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "VSB AI & DS Portal Desktop Dashboard"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "VSB AI & DS Portal Mobile Attendance and Study View"
    }
  ],
  "shortcuts": [
    {
      "name": "Student Login",
      "short_name": "Login",
      "url": "/login",
      "description": "Sign in to your Student Account",
      "icons": [
        {
          "src": "/shortcut-icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "description": "View Student Academic Dashboard",
      "icons": [
        {
          "src": "/shortcut-icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}

# ==============================================================================
# V.S.B. AI & DS DIGITAL PORTAL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and fill in your actual production values.
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# Database Connection (Supabase / PostgreSQL)
# Transaction Pooler URL (e.g. port 6543 with pgbouncer=true for serverless)
DATABASE_URL=""
# Direct Session URL (e.g. port 5432 for migrations and schema push)
DIRECT_URL=""

# Authentication & Session Security (Min 32 random characters)
NEXTAUTH_URL=""
NEXTAUTH_SECRET=""

# Default Temporary Password for Bulk Student Imports (forced change on first login)
DEFAULT_STUDENT_TEMP_PASSWORD=""

# Supabase Client & Backend Configuration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-Side Only — NEVER expose with NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=""

# SMTP Configuration (Official Email Alerts & Admin OTP)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
ADMIN_EMAIL=""
EMAIL_FROM=""

# Application Branding & Metadata (Public display in UI)
NEXT_PUBLIC_APP_NAME="V.S.B. AI & DS Digital Portal"
NEXT_PUBLIC_COLLEGE_NAME="V.S.B. Engineering College"
NEXT_PUBLIC_DEPARTMENT="Artificial Intelligence & Data Science"
NEXT_PUBLIC_LOCATION="Karur, Tamil Nadu, India"

# Server Environment & Port Configuration
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"

# File Upload Limits
UPLOAD_MAX_SIZE="10485760"
UPLOAD_ALLOWED_TYPES="pdf,jpg,jpeg,png,doc,docx"

# OTP Security & Rate Limiting
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="3"
OTP_RESEND_COOLDOWN_SECONDS="60"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Google Gemini AI (Server-Side Only — used exclusively by /api/ai)
GEMINI_API_KEY=""

# Web Push Notifications (VAPID)
# Public key used by browsers to subscribe
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Private key used by backend server to sign push dispatches — Server-Side Only
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# SMS & WhatsApp Gateway (Fast2SMS / Twilio / Meta WhatsApp)
# Server-Side Only
FAST2SMS_API_KEY=""
FAST2SMS_WHATSAPP_API_KEY=""
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=""
FAST2SMS_WHATSAPP_MESSAGE_ID=""
FAST2SMS_WHATSAPP_TEMPLATE_NAME=""

# Twilio (Alternative Gateway)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_FROM=""

# Meta WhatsApp Cloud API (Alternative Gateway)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Distributed Rate Limiting (Optional Upstash Redis Fast-Path)
# If not configured, rate limiting automatically runs on PostgreSQL shared database store.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Paid API Hard Monthly Spending / Quota Caps
MONTHLY_AI_BUDGET_CAP="2000"
MONTHLY_SMS_BUDGET_CAP="500"
MONTHLY_EMAIL_BUDGET_CAP="2500"
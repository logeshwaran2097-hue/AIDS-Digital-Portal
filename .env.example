# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# SMTP Configuration for Admin OTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
ADMIN_EMAIL="lonelyboy44y@gmail.com"

# Email From Address
EMAIL_FROM="V.S.B. AI & DS Portal <noreply@vsb.edu.in>"

# App Configuration
NEXT_PUBLIC_APP_NAME="V.S.B. AI & DS Digital Portal"
NEXT_PUBLIC_COLLEGE_NAME="V.S.B. Engineering College"
NEXT_PUBLIC_DEPARTMENT="Artificial Intelligence & Data Science"
NEXT_PUBLIC_LOCATION="Karur, Tamil Nadu, India"

# Development Mode
NODE_ENV="development"

# File Upload
UPLOAD_MAX_SIZE="10485760"
UPLOAD_ALLOWED_TYPES="pdf,jpg,jpeg,png,doc,docx"

# OTP Configuration
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="3"
OTP_RESEND_COOLDOWN_SECONDS="60"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Twilio Cloud SMS & WhatsApp (real-time parent alerts)
# Get from https://console.twilio.com -> Account -> API keys
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# E.164 Twilio phone number for SMS (must be verified in Twilio console)
TWILIO_PHONE_NUMBER="+15551234567"
# Twilio WhatsApp sender — sandbox or approved business number
# Sandbox default: whatsapp:+14155238886  (join keyword required)
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Optional alternative: Fast2SMS for India domestic SMS
# FAST2SMS_API_KEY="your_fast2sms_key"

# Meta WhatsApp Cloud API (alternative to Twilio WhatsApp)
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_token"

# Google Gemini AI
GEMINI_API_KEY="your_gemini_api_key_here"